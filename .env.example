# Copy this file to ".env" (in this folder or the folder above it) and paste your key after the "=".
# The key name must be exactly PORTKEY_API_KEY. Never commit .env.
# Left empty, this line does not hide a key that is set in the .env of the folder above.
PORTKEY_API_KEY=

# ---- Optional tuning (defaults shown; uncomment to change) ----
# Spend and loop caps
# RUN_BUDGET_USD=0.05
# RUN_TOKEN_CAP=250000
# DAILY_BUDGET_USD=2.00
# MAX_STEPS_PER_AGENT=8
# MAX_TOOL_CALLS_PER_RUN=30
# MAX_MODEL_CALLS_PER_RUN=12   (every attempt counts: guard, agent turns, retries)
# LLM_MAX_RETRIES=1            (each failed attempt is written to the ledger)
# MAX_AGENT_DEPTH=2
# MAX_OUTPUT_TOKENS=4000
# LLM_TIMEOUT_S=90

# Input limits and rate limiting (per client IP)
# MAX_INPUT_CHARS=8000
# RATE_LIMIT_RUNS=15
# RATE_LIMIT_WINDOW_S=600

# Safety: set to 0 or false to disable the extra LLM guard call on user input
# SAFETY_LLM_GUARD=1

# Tokenomics projection assumption
# RUNS_PER_USER_PER_MONTH=30

# Paths (relative paths resolve against this folder)
# DATA_DIR=data/sample
# RUNS_DIR=runs

# Server port (Render sets this automatically)
# PORT=8000
