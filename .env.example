# Copy this file to ".env" (in this folder or the folder one level above it) and paste your key after the "=".
# The key name must be exactly PORTKEY_API_KEY. It is the only required setting. Never commit .env.
# Left empty, this line does not hide a key that is set in the .env of the folder above.
PORTKEY_API_KEY=

# ---- Optional settings (defaults from app/config.py shown; remove the "# " to change one) ----
# An invalid value keeps the default. Keep comments on their own lines, not after a value.

# Spend and loop caps
# RUN_BUDGET_USD=0.05
# RUN_TOKEN_CAP=250000
# 0 switches AI matching off; Browse all still works.
# DAILY_BUDGET_USD=2.00
# Every model attempt counts: guard, agent turns, retries.
# MAX_MODEL_CALLS_PER_RUN=12
# Each failed attempt is written to the ledger.
# LLM_MAX_RETRIES=1
# MAX_TOOL_CALLS_PER_RUN=30
# MAX_OUTPUT_TOKENS=4000

# Time limits (seconds): one whole run, one model call
# RUN_TIMEOUT_S=180
# LLM_TIMEOUT_S=90

# Input limit and rate limiting (per client IP)
# MAX_INPUT_CHARS=8000
# RATE_LIMIT_RUNS=15
# RATE_LIMIT_WINDOW_S=600

# Safety: 0 skips the extra gpt-6-luna guard call on each request
# SAFETY_LLM_GUARD=1

# Usage tab projection assumption
# RUNS_PER_USER_PER_MONTH=30

# Runtime output: ledger, traces, refreshed listings (relative paths resolve against this folder)
# RUNS_DIR=runs

# Seconds between two "Refresh sources" (polite to the source sites)
# REFRESH_COOLDOWN_S=300

# Port when --port is not given
# PORT=8000

# Demo modes (unset by default)
# LLM_SIMULATE=timeout makes every model call fail after a delay (or "error"); no network call, no cost.
# LLM_SIMULATE=timeout
# LLM_SIMULATE_DELAY_S=8
# COLLECT_SIMULATE_OUTAGE=1 makes "Refresh sources" fail as if the source sites were down.
# COLLECT_SIMULATE_OUTAGE=1
